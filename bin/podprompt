#!/bin/bash
# Source ~/.podprompt.env (or export the required variables in your shell)
# before running. Run with --help for full usage information.
#
# Must stay bash-3.2-compatible: macOS ships bash 3.2 as /bin/bash by
# default (last GPLv2 release; Apple hasn't updated it) and this script's
# shebang runs under whatever /bin/bash actually is, regardless of any
# newer bash a user may have on PATH via Homebrew. Avoid mapfile/readarray,
# declare -A, and ${var,,}/${var^^} — none of those exist before bash 4.

# ── Where this checkout lives ─────────────────────────────────────────────────
# This command is meant to be run from the directory you want mounted as
# /workspace, which means it can be invoked from anywhere and must never
# infer its own location from the cwd. Everything it needs from the checkout
# (viewer/ to deploy, Dockerfile to build) is resolved from here instead.
#
# Symlinks are followed deliberately: `ln -s .../bin/podprompt ~/.local/bin/`
# is the most idiomatic way to put a command on PATH, and without this loop
# the link's own directory would be mistaken for the checkout. `readlink -f`
# would be one line, but BSD readlink (macOS) has no -f, so this walks the
# chain by hand — which is also bash-3.2-safe.
resolve_self_dir() {
    local src="${BASH_SOURCE[0]}" link_dir
    while [ -L "$src" ]; do
        link_dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        # A relative symlink target resolves against the link's directory,
        # not against the cwd.
        case "$src" in
            /*) ;;
            *) src="$link_dir/$src" ;;
        esac
    done
    cd -P "$(dirname "$src")" && pwd
}

SELF_DIR="$(resolve_self_dir)"
REPO_DIR="$(cd "$SELF_DIR/.." && pwd)"

usage() {
    cat <<'USAGE'
Usage: podprompt [OPTIONS] [PASSTHROUGH_ARGS...]

Launches a coding agent (Claude Code or OpenCode) inside a Docker sandbox,
mounting your current directory as the workspace, your real ~/.claude for
persistent Claude Code auth/settings, and PodPrompt's own state/data
directories for the viewer app and its bookkeeping.

RUN IT FROM THE PROJECT YOU WANT TO WORK ON. The current directory is an
implicit argument: it becomes /workspace inside the container, writable by
the agents. Put this command on your PATH once and invoke it anywhere:

    export PATH="/path/to/podprompt/bin:$PATH"     # in ~/.bashrc or ~/.zshrc
    source /path/to/podprompt/activate.sh          # or just for this shell

The checkout stays where it is and is resolved from this command's own
location, so viewer deployment and image builds work from any directory.
Symlinking bin/podprompt onto your PATH works too. Moving or deleting the
checkout breaks the command — it is permanent infrastructure, not scratch.

FIRST RUN:

    podprompt --build            # build the Docker image
    podprompt --deploy-viewer    # install the viewer app
    podprompt --claude           # one-time sign-in, if using a subscription
    cd ~/some/project && podprompt

PROVIDER OPTIONS (mutually exclusive; --direct is the default):

  (default)       Authenticate via your claude.ai subscription (OAuth). No API
  --direct        key required. On first run you will be walked through a browser-
                  based OAuth flow; credentials are saved into ~/.claude/
                  and reused on subsequent runs. Usage is billed to your Claude
                  subscription (Pro / Team / Enterprise), not to an API account.

  --direct-api    Use the Anthropic API directly with an API key, billed per token
                  to your Anthropic Console account. Requires ANTHROPIC_API_KEY to
                  be set. Claude Code connects to api.anthropic.com and uses its
                  built-in default model.

  --litellm       Route requests through your LiteLLM proxy instance.
                  Requires LITELLM_URL and LITELLM_API_KEY. An interactive
                  model picker runs automatically before launch — you select
                  the primary model and optionally a small/fast model for
                  background tasks. The following env vars are set automatically
                  to make Claude Code work correctly against a non-Anthropic
                  endpoint:
                    ANTHROPIC_BASE_URL              → LITELLM_URL
                    ANTHROPIC_AUTH_TOKEN            → LITELLM_API_KEY
                    ANTHROPIC_MODEL                 → your picked model
                    ANTHROPIC_DEFAULT_HAIKU_MODEL   → your picked small model
                    ANTHROPIC_SMALL_FAST_MODEL      → your picked small model
                    DISABLE_NON_ESSENTIAL_MODEL_CALLS=1 (if no small model picked)
                    CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
                    DISABLE_TELEMETRY=1

INTERFACE OPTIONS (mutually exclusive; --viewer is the default):

  (default)       Start PodPrompt's browser-based viewer/driver UI (see
  --viewer        --viewer below) — a bare `podprompt` with no interface
                  flag now gives you this, not a terminal session.

  --claude, --claude-code
                  Skip the viewer and drop straight into Claude Code's own
                  interactive terminal UI (`claude`) inside the container
                  instead — a plain terminal session with no browser
                  involved. Mutually exclusive with --viewer and with
                  --opencode: pick exactly one interface per launch.

  --opencode      Same, but OpenCode's own terminal UI (`opencode`) instead
                  of Claude Code's. OpenCode manages its own provider/model
                  credentials entirely separately from --direct/--direct-api
                  above (see `opencode auth login`, or just use this flag
                  once — its first-run login flow persists to this host's
                  own standard config/data directories, e.g.
                  ~/.config/opencode/, independent of ~/.claude/ — see
                  PERSISTENT STATE below).

                  --litellm IS meaningful with --opencode, though —
                  LiteLLM's default wire protocol is OpenAI-compatible,
                  which is a first-class, arguably simpler fit for OpenCode
                  than for Claude Code (which needs the Anthropic-shaped env
                  vars documented under --litellm above; OpenCode has no use
                  for those). `--opencode --litellm` skips Claude Code's
                  interactive model picker (nothing here would ever read
                  its result) and instead passes LITELLM_URL/LITELLM_API_KEY
                  into the container as plain env vars, for a custom
                  provider block in opencode.jsonc to pick up via OpenCode's
                  own {env:LITELLM_URL}/{env:LITELLM_API_KEY} config
                  substitution:

                    { "$schema": "https://opencode.ai/config.json",
                      "provider": { "litellm": {
                        "npm": "@ai-sdk/openai-compatible",
                        "options": { "baseURL": "{env:LITELLM_URL}/v1",
                                     "apiKey": "{env:LITELLM_API_KEY}" },
                        "models": { "your-model-name": {} } } } }

                  List what LiteLLM actually exposes first with
                  --list-models. If {env:...} substitution for apiKey
                  doesn't seem to take (a known rough edge in some OpenCode
                  versions), store the key via the TUI's /connect flow under
                  the same provider id instead and drop apiKey from the
                  config entirely.

  --viewer        Start PodPrompt, the browser-based viewer/driver UI — the
                  default (this flag only ever needs to be explicit, e.g.
                  from a script). Opens a rendered view of the agent's
                  responses (markdown, math, syntax-highlighted code) at
                  http://localhost:VIEWER_PORT, with a bidirectional driver
                  (built on the Claude Agent SDK) so the browser drives
                  prompts directly — no terminal UI is attached at all.
                  Requires the viewer/ app files (server.py, viewer.html,
                  start-viewer.sh, driver.mjs, backends/) to be copied into
                  ~/.local/share/podprompt/viewer/ first (see
                  --deploy-viewer below). The viewer's Node dependency (the
                  Claude Agent SDK) is baked into the Docker image itself,
                  not part of this copy — see --deploy-viewer. Both the
                  claude-code and opencode backends are always available to
                  pick per-session from the browser's "+ New chat" picker —
                  this also starts a
                  headless `opencode serve` instance inside the container
                  for you, so nothing needs to be started by hand first.
                  There is no command-line flag for "the default backend"
                  anymore: the new-chat picker just remembers whichever
                  backend you started your last new chat with, falling back
                  to Claude Code on a fresh install with no history yet.

  --viewer-port PORT
                  Port for the viewer server (browser page + SSE feed).
                  Default: 7843.

  --viewer-driver-port PORT
                  Port for the bidirectional driver (accepts prompts/
                  permission responses from the browser). Default: 7844.

  --opencode-port PORT
                  Loopback-only port `opencode serve` listens on inside the
                  container, and that driver.mjs's opencode backend connects
                  to. Never published to the host via -p (driver.mjs and
                  `opencode serve` talk to each other inside the container's
                  own network namespace; --host-network drops the -p publishes
                  anyway) — only worth changing if something else inside the
                  image ever collides with the default.
                  Relevant whenever `opencode serve` might run at all: under
                  --viewer (always) or under a plain --opencode launch.
                  Default: 7845.

  --image NAME    Run a different image instead of 'podprompt'. For a local
                  variant built on the base — a Dockerfile starting
                  `FROM podprompt` that adds tooling you need for one kind of
                  work. The image must carry the org.podprompt.base label,
                  which anything built FROM podprompt inherits automatically;
                  anything without it is refused.

                  One container runs at a time, so this changes which image
                  that container uses rather than running two at once. Every
                  bit of podprompt state lives in host mounts, so switching
                  images keeps your sessions, credentials and settings.

                  Cannot be combined with --build, which always builds this
                  checkout's Dockerfile and tags it 'podprompt'.

  --host-network  Launch the container with Docker host networking
                  (--network host), sharing the host's network stack
                  instead of the default bridge network. Lets the
                  container reach services the host listens on
                  loopback-only (e.g. a llama-server bound to
                  127.0.0.1:8080) at the same 127.0.0.1 address, with no
                  -p port publishes. The viewer services bind loopback in
                  this mode rather than 0.0.0.0, so there is still no LAN
                  exposure even though the container shares the host's
                  interfaces. Native and
                  reliable on Linux. On macOS this needs Docker Desktop
                  4.34+ with Settings > Resources > Network > "Enable
                  host networking" turned on — and even then the
                  host-to-container direction (e.g. the viewer in a
                  browser) can be unreliable there; that direction works
                  fine on Linux. Default is off (bridged container).

  --env NAME      Pass an extra environment variable into the container,
  --env NAME=VALUE
                  forwarded as `docker run -e NAME` or `-e NAME=VALUE`
                  respectively — same two forms `docker run -e` itself
                  accepts. The bare NAME form inherits the current value of
                  $NAME from your own shell; NAME=VALUE sets it inline.
                  Repeatable.

                  Mainly for a custom OpenCode provider you've hand-written
                  into opencode.jsonc that needs a credential OpenCode's own
                  config substitution can read via {env:NAME} — the same
                  role LITELLM_URL/LITELLM_API_KEY already play for
                  --litellm above, generalized to any provider and any
                  variable name.

                  The container's env is captured once, at container launch
                  — nothing exported into a shell afterward (even one
                  inside the container) reaches an already-running session.
                  So for a credential that expires, "relaunch podprompt
                  with a freshly minted value" is the refresh step, not
                  something this flag does on its own. That is safe to lean
                  on here specifically because all of PodPrompt's own state
                  lives in host mounts (see PERSISTENT STATE below) — a
                  relaunch is cheap and loses nothing.

                  Prefer the bare NAME form for secrets: NAME=VALUE makes
                  the value briefly visible in `ps` output on the host and,
                  unless you're careful to use command substitution instead
                  of a literal, in your shell history. Either form still
                  lands in the container's env broadly — visible to both
                  backends, to driver.mjs, and to any shell command either
                  agent runs inside the container, same as any other -e var
                  already passed today (e.g. LITELLM_API_KEY).

                  Out of scope for now: a --env-file passthrough for
                  batching multiple variables from a file instead of
                  repeating this flag.

UTILITY OPTIONS:

  --build         Build the 'podprompt' Docker image from this checkout and
                  exit. Equivalent to `docker build -t podprompt .` run from
                  the checkout, but works from any directory. Re-run it when
                  the Dockerfile changes, and when viewer/package.json or
                  viewer/package-lock.json changes — those are build inputs,
                  and --deploy-viewer alone will not pick them up.

                  Rebuilding moves the 'podprompt' tag to the new image and
                  leaves the old one untagged. That superseded image is
                  removed, so rebuilds do not accumulate; one still in use by
                  a container is kept, and said so.

  --list-models   Print all models currently available on the LiteLLM instance
                  and exit. Does not start a Claude Code session.
                  Requires LITELLM_URL and LITELLM_API_KEY.

  --deploy-viewer Copy this repo's viewer/ app files (server.py, viewer.html,
                  start-viewer.sh, driver.mjs, backends/) into
                  ~/.local/share/podprompt/viewer/. This is the supported
                  way to deploy the viewer's app code — run it after pulling
                  updated viewer code, then start with --viewer (which
                  restarts the container and serves the fresh files). A pure
                  file copy: bytecode caches and scratch/notes are never
                  carried over. Does NOT install or touch node_modules —
                  the viewer's Node dependency is baked into the Docker
                  image at build time instead (see the Dockerfile), so it's
                  always installed for the image's own actual platform
                  rather than whichever platform runs this script. If
                  viewer/package.json's dependency changes, rebuild the
                  image (podprompt --build); --deploy-viewer alone
                  won't pick that up.

  --help, -h      Show this message and exit.

PASS-THROUGH ARGUMENTS:

  Any option not listed above is passed directly to whichever binary
  --claude/--opencode selects (`claude` or `opencode`) — only meaningful
  alongside one of those two flags, since --viewer (the default) never
  execs either binary directly; passthrough args given alongside --viewer
  are ignored, with a warning, rather than silently dropped. For
  --claude/--claude-code, this includes Claude Code's own flags, for
  example:

    --dangerously-skip-permissions   Disable Claude Code's permission prompts.
                                     Only use this against repos you trust fully.
    --print "some prompt"            Run non-interactively and print output.
    --agent AGENT_NAME               Launch a specific subagent at startup.

  For --opencode, these are opencode's own flags instead (see
  `opencode --help`), for example:

    --continue                       Continue the last session.
    --model PROVIDER/MODEL           Use a specific model for this run.

  Pass-through args are forwarded after all recognised flags have been consumed,
  so you can freely mix them:

    podprompt --claude --litellm --dangerously-skip-permissions
    podprompt --opencode --continue

ENVIRONMENT VARIABLES:

  Keep these in ~/.podprompt.env (chmod 600) rather than hardcoding them
  in this script.

    ANTHROPIC_API_KEY      API key for --direct-api mode only. Not needed for
                           OAuth (--direct) or LiteLLM (--litellm) modes.

    LITELLM_URL            Base URL of your LiteLLM proxy instance.
                           e.g. https://llm.example.com

    LITELLM_API_KEY        API key accepted by your LiteLLM instance.

PERSISTENT STATE:

  ~/.claude (your real, standard Claude Code config directory — the same one
  a native, non-Docker `claude` install would use) is bind-mounted into the
  container as /home/agent/.claude. This directory holds your Claude Code
  OAuth credentials, settings.json, session history, and per-project trust
  decisions — shared with any native install on this host, not a
  container-only copy.

  OpenCode gets its own separate, standard set of mounts instead — each of
  the host's own ~/.config/opencode/, ~/.local/share/opencode/,
  ~/.local/state/opencode/, and ~/.cache/opencode/ is bind-mounted straight
  onto the identical default path inside the container (no XDG_*_HOME
  redirection needed — that's already where a plain `opencode` looks; see
  `opencode debug paths`). A login done via `--opencode`'s TUI is
  what --viewer's headless `opencode serve` then uses too, and vice versa,
  since both get the same four mounts.

  PodPrompt's own state — the deployed viewer app (server.py, viewer.html,
  driver.mjs, etc.) and its bookkeeping files (viewer-session-hosts.json,
  viewer-model-picks.json, viewer-last-backend.json) — lives in its own
  XDG-style directories, independent of both of the above, so neither Claude
  Code's nor OpenCode's own config directory gets polluted with
  PodPrompt-internal files:
  ~/.local/share/podprompt/viewer/ (the deployed app, --viewer only) and
  ~/.local/state/podprompt/ (bookkeeping). ~/.config/podprompt/ is reserved
  for future use; nothing reads it yet.

  All of the above directories are created by Docker on first use if they
  don't already exist on the host, and all of it persists across container
  restarts. Back it up if it matters to you.

EXAMPLES:

  # First-time setup: build the image, then install the viewer app
  podprompt --build
  podprompt --deploy-viewer

  # Normal session — browser viewer, both backends available (default)
  podprompt

  # Claude Code's own terminal UI instead of the viewer
  podprompt --claude

  # OpenCode's own terminal UI instead of the viewer
  podprompt --opencode

  # API-key billing instead of subscription (viewer, or --claude)
  podprompt --direct-api

  # LiteLLM — interactive model picker runs automatically (Claude Code TUI
  # only; skipped for --opencode, meaningless for --viewer — see --litellm
  # above)
  podprompt --claude --litellm

  # List available LiteLLM models without launching
  podprompt --list-models

  # Viewer on a different port
  podprompt --viewer-port 7900

  # OpenCode's own terminal UI against your LiteLLM instance
  # (LITELLM_URL/LITELLM_API_KEY passed through for opencode.jsonc's own
  # custom-provider config)
  podprompt --opencode --litellm

  # Pass a flag through to claude (only meaningful with --claude)
  podprompt --claude --dangerously-skip-permissions

  # Pass a one-off credential through to a custom opencode.jsonc provider,
  # e.g. one using {env:ALCF_AI_TOKEN} for its apiKey. The bare NAME form
  # inherits the value from your own shell rather than putting it on this
  # command line.
  ALCF_AI_TOKEN=$(alcf-ai auth get-access-token) podprompt --opencode --env ALCF_AI_TOKEN
USAGE
}

# --- Credentials & config -----------------------------------------------
# All of these can come from ~/.podprompt.env instead of being set here.
ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
LITELLM_URL="${LITELLM_URL:-<MY-LITELLM-URL>}"
LITELLM_API_KEY="${LITELLM_API_KEY:-}"

VIEWER_PORT=7843
VIEWER_DRIVER_PORT=7844
# Claude Code's own real, standard config directory — the same one a native,
# non-Docker `claude` install already uses (~/.claude, plus the .claude.json
# CLAUDE_CONFIG_DIR consolidates into it below), not a PodPrompt-branded copy.
CONFIG_DIR="$HOME/.claude"
# OpenCode's own config/data/state/cache — real, standard host locations
# (matching what a native, non-Docker opencode install already uses; see
# `opencode debug paths`), independent of CONFIG_DIR. Kept separate so
# OpenCode's state doesn't get bundled with Claude Code's, and so it can be
# inspected/backed up on its own terms.
OPENCODE_CONFIG_DIR="$HOME/.config/opencode"
OPENCODE_DATA_DIR="$HOME/.local/share/opencode"
OPENCODE_STATE_DIR="$HOME/.local/state/opencode"
OPENCODE_CACHE_DIR="$HOME/.cache/opencode"
# PodPrompt's own state — XDG-style, same shape as OpenCode's block above,
# and independent of both backends' own directories so PodPrompt's internal
# bookkeeping (viewer-session-hosts.json, viewer-model-picks.json) never
# ends up inside the real ~/.claude a native install also uses.
# PODPROMPT_DATA_DIR/viewer holds the deployed viewer app itself (server.py,
# viewer.html, driver.mjs, ...) — see --viewer's usage note above for what
# needs to be copied there before --viewer works.
PODPROMPT_DATA_DIR="$HOME/.local/share/podprompt"
PODPROMPT_STATE_DIR="$HOME/.local/state/podprompt"
# ------------------------------------------------------------------------

# ── Port cleanup ──────────────────────────────────────────────────────────────
free_host_port() {
    local port="$1"
    local pid cmd
    pid=$(lsof -ti tcp:"$port" 2>/dev/null)
    [ -n "$pid" ] || return 0

    # Only ever reap a PID we can positively identify as this project's — a
    # leftover docker-proxy for the podprompt container, or a stale
    # server.py/driver.mjs/start-viewer.sh. A port that's happened to collide
    # with some unrelated service must NOT be killed out from under it: abort
    # with a clear message instead.
    cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)

    local ours=0
    if [[ "$cmd" == *docker-proxy* ]] \
       && command -v docker >/dev/null 2>&1 \
       && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx podprompt; then
        ours=1   # stale proxy from a previous podprompt container
    elif [[ "$cmd" == *podprompt* || "$cmd" == *server.py* \
            || "$cmd" == *start-viewer.sh* || "$cmd" == *driver.mjs* ]]; then
        ours=1   # our own viewer/driver process
    fi

    if [ "$ours" != 1 ]; then
        echo "[viewer] Port $port is in use by an unrecognized process (PID $pid): $cmd" >&2
        echo "[viewer] Refusing to kill it. Free the port yourself, or use --viewer-port/--viewer-driver-port to avoid the collision." >&2
        return 1
    fi

    echo "[viewer] Reaping stale process on port $port (PID $pid)..."
    kill "$pid" 2>/dev/null
    # Wait up to 2s for it to die
    local i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
        sleep 0.2
        i=$((i+1))
    done
    kill -9 "$pid" 2>/dev/null || true
    return 0
}

cleanup() {
    if [ "$VIEWER_ENABLED" = 1 ]; then
        [ -n "$VIEWER_OPEN_PID" ] && kill "$VIEWER_OPEN_PID" 2>/dev/null
        free_host_port "$VIEWER_PORT"
    fi
}
trap cleanup EXIT INT TERM

# ── Browser auto-open ─────────────────────────────────────────────────────────
open_browser() {
    local url="$1"
    if command -v open >/dev/null 2>&1; then
        open "$url" >/dev/null 2>&1
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1
    elif command -v wslview >/dev/null 2>&1; then
        wslview "$url" >/dev/null 2>&1
    else
        echo "[viewer] Couldn't find a command to open a browser automatically. Open $url manually." >&2
        return 1
    fi
}

wait_and_open_viewer() {
    local port="$1"
    local url="http://localhost:$port"
    local i=0
    while [ $i -lt 50 ]; do
        if curl -s --max-time 1 -o /dev/null "$url"; then
            open_browser "$url"
            return
        fi
        sleep 0.2
        i=$((i+1))
    done
    echo "[viewer] Timed out waiting for $url to come up; open it manually." >&2
}

fetch_litellm_models() {
    if [ -z "$LITELLM_API_KEY" ]; then
        echo "Error: LITELLM_API_KEY is not set." >&2
        exit 1
    fi
    local result
    result=$(curl -s "$LITELLM_URL/v1/models" \
        -H "Authorization: Bearer $LITELLM_API_KEY")
    if ! echo "$result" | jq -e '.data' >/dev/null 2>&1; then
        echo "Error: couldn't parse a model list from $LITELLM_URL/v1/models" >&2
        echo "$result" >&2
        exit 1
    fi
    echo "$result"
}

list_models() {
    echo "Models available on $LITELLM_URL:"
    fetch_litellm_models | jq -r '.data[].id' | sort
}

build_image() {
    # Builds from the checkout rather than the cwd, so `podprompt --build`
    # works from anywhere. Without this the one step that still required
    # standing in the checkout would be the odd one out, and users would have
    # to remember both where the checkout is and what tag to use.
    if [ ! -f "${REPO_DIR}/Dockerfile" ]; then
        echo "Error: no Dockerfile in this checkout (${REPO_DIR})." >&2
        exit 1
    fi
    # Rebuilding with the same tag MOVES the tag and leaves the previous image
    # behind, untagged, holding every layer the new build did not reuse. Nothing
    # tells you that, and it accumulates one superseded image per rebuild. So
    # note which image the tag pointed at, and clean it up afterwards.
    local before after
    before="$(docker image inspect -f '{{.Id}}' podprompt 2>/dev/null)" || before=""

    echo "Building the podprompt image from ${REPO_DIR}..."
    docker build -t podprompt "$REPO_DIR" || exit 1

    after="$(docker image inspect -f '{{.Id}}' podprompt 2>/dev/null)" || after=""

    if [ -n "$before" ] && [ "$before" != "$after" ]; then
        # A container still referencing the image pins it, and that is reason
        # enough to leave it alone. Not forced: -f would untag an image out
        # from under something that is using it. Reported either way, in our
        # own words rather than docker's.
        if docker image rm "$before" >/dev/null 2>&1; then
            echo "Removed the image this one replaced."
        else
            echo "The image this replaced is still in use, so it was kept:" \
                 "${before#sha256:} (now untagged)."
        fi
    fi

    echo "Image built. Deploy the viewer app with 'podprompt --deploy-viewer' if you have not already."
}

require_image() {
    # Checked before anything slow or stateful happens. The raw Docker error
    # for a missing image says nothing about how to fix it, and now that this
    # command runs from anywhere the user may be nowhere near the checkout.
    if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        if [ "$IMAGE_EXPLICIT" = 1 ]; then
            echo "Error: no Docker image named '$IMAGE_NAME'." >&2
        else
            echo "Error: the 'podprompt' Docker image does not exist yet." >&2
            echo "Build it with:  podprompt --build" >&2
        fi
        exit 1
    fi

    # The image has to say it is one of ours. This is what makes --image safe
    # to aim at a local variant rather than a leap of faith: labels are
    # inherited through FROM, so an image built `FROM podprompt` carries this
    # one already and passes without its author doing anything.
    if [ "$(docker image inspect -f '{{index .Config.Labels "org.podprompt.base"}}' \
            "$IMAGE_NAME" 2>/dev/null)" != 1 ]; then
        if [ "$IMAGE_EXPLICIT" = 1 ]; then
            echo "Error: '$IMAGE_NAME' has no org.podprompt.base label, so it was not run." >&2
        else
            # An image built before the label existed. Telling someone their
            # podprompt image is not a podprompt image would read as nonsense.
            echo "Error: the 'podprompt' image predates the org.podprompt.base label." >&2
            echo "Rebuild it with:  podprompt --build" >&2
        fi
        exit 1
    fi
}

deploy_viewer() {
    # The supported way to get the viewer's app code deployed: copy this
    # repo's viewer/ app files into PodPrompt's own data directory, so the
    # mounted ~/.local/share/podprompt/viewer is always a fresh mirror of
    # this checkout rather than whatever a hand-copied deploy last put
    # there. Run it after pulling updated viewer code; then start with
    # --viewer, which restarts the container around the new files.
    #
    # This is a pure file copy now — no dependency install happens here.
    # The viewer's one Node dependency (the Claude Agent SDK) is baked into
    # the Docker image at build time instead (see Dockerfile), specifically
    # so it's always installed for the image's own actual platform rather
    # than whatever platform happens to run this script (a real difference
    # on macOS, where `npm install` would otherwise fetch darwin binaries
    # into a container that needs linux ones). package.json/package-lock.json
    # are therefore not copied here either — they only matter to the
    # Dockerfile's own build-time npm install now. If you've changed
    # viewer/package.json's dependency, rebuild the image
    # (podprompt --build) — --deploy-viewer alone will not pick that
    # up.
    local src_dir target_dir
    src_dir="${REPO_DIR}/viewer"
    target_dir="${PODPROMPT_DATA_DIR}/viewer"

    if [ ! -d "$src_dir" ]; then
        echo "Error: no viewer/ directory in this checkout ($src_dir)." >&2
        echo "The podprompt command resolves its checkout from its own location." >&2
        echo "If the checkout has moved or been deleted, update PATH to point at the new one." >&2
        exit 1
    fi

    # A sanity check on the CHECKOUT, not the copy manifest — see the derived
    # manifest below for what actually gets deployed. These are the files whose
    # absence means you are pointed at something that is not a viewer/, and
    # saying so here beats a confusing failure inside the container later. It
    # does not need to be exhaustive and must never be used to decide what to
    # copy.
    local required=(server.py viewer.html start-viewer.sh driver.mjs backends)
    local missing=()
    local f
    for f in "${required[@]}"; do
        [ -e "$src_dir/$f" ] || missing+=("$f")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        echo "Error: this repo's viewer/ is missing required files:" >&2
        printf '  %s\n' "${missing[@]}" >&2
        exit 1
    fi

    mkdir -p "$target_dir"

    # WHAT GETS COPIED: everything in viewer/, minus a short skip list.
    #
    # This used to be the hand-written `required` list above, and the cost of
    # that showed up the first time someone split a module out: the new file
    # was not named here, so it was never deployed, so the driver died on
    # import inside the container while the repo looked perfectly fine. The
    # viewer came up with no sessions at all and the only evidence was an
    # ERR_MODULE_NOT_FOUND buried in the driver log.
    #
    # Deriving the manifest flips which way a mistake fails. Forgetting to add
    # something to an allow-list breaks the deployment; forgetting to add
    # something to the skip list below deploys one harmless extra file. Only
    # one of those is worth a debugging session.
    #
    # Skipped on purpose:
    #   *.test.mjs      tests; nothing at runtime imports them
    #   package*.json   dependencies are baked into the image, not deployed
    #                   here (see this function's header)
    #   node_modules    same
    #   __pycache__     build droppings
    # Dotfiles are skipped too, by the glob rather than by name.
    local manifest=()
    local entry name
    for entry in "$src_dir"/*; do
        [ -e "$entry" ] || continue          # unmatched glob stays literal
        name="$(basename "$entry")"
        case "$name" in
            *.test.mjs|package.json|package-lock.json|node_modules|__pycache__)
                continue ;;
        esac
        manifest+=("$name")
    done

    # Copying never removes, so a module renamed or deleted in the repo stays
    # in the deployed copy. Harmless for something nothing imports — chains.mjs
    # sat here long after it was deleted — but a RENAME leaves both the old and
    # the new file present, and which one wins is then down to whatever still
    # references the old name.
    #
    # Reported, never removed. A file here that this deploy does not manage is
    # just as likely to be something put there deliberately to patch a running
    # deployment, and silently deleting that would cost far more than the
    # clutter does. Whether a stray is stale or load-bearing is the user's call.
    local known strays
    strays=0
    for entry in "$target_dir"/*; do
        [ -e "$entry" ] || continue          # unmatched glob stays literal
        name="$(basename "$entry")"
        known=0
        for f in "${manifest[@]}"; do
            if [ "$name" = "$f" ]; then
                known=1
                break
            fi
        done
        if [ "$known" = 0 ]; then
            if [ "$strays" = 0 ]; then
                echo "Note: $target_dir holds files this deploy does not manage:"
                strays=1
            fi
            echo "    $name"
        fi
    done

    for f in "${manifest[@]}"; do
        cp -r "$src_dir/$f" "$target_dir/"
    done
    chmod +x "$target_dir/start-viewer.sh"

    if grep -q '<title>PodPrompt</title>' "$target_dir/viewer.html"; then
        echo "Viewer app files deployed to $target_dir."
        echo "Dependencies live in the Docker image, not here — rebuild it (podprompt --build) if viewer/package.json changed."
        echo "Start it with --viewer (container restart happens automatically); hard-refresh the browser tab if you were already connected."
    else
        echo "Viewer app files deployed to $target_dir." >&2
        echo "Warning: deployed viewer.html title is not 'PodPrompt' — source checkout may be out of date." >&2
        exit 1
    fi
}

pick_model() {
    local models_json
    models_json=$(fetch_litellm_models)
    local model_list
    # Portable bash-3.2 equivalent of `mapfile -t` (macOS's default
    # /bin/bash predates mapfile/readarray, added in bash 4.0).
    model_list=()
    while IFS= read -r line; do
        model_list+=("$line")
    done < <(echo "$models_json" | jq -r '.data[].id' | sort)

    if [ ${#model_list[@]} -eq 0 ]; then
        echo "Error: no models returned from LiteLLM." >&2
        exit 1
    fi

    # ── Primary model ──────────────────────────────────────────────────────
    echo ""
    echo "Available models on $LITELLM_URL:"
    echo ""
    local i=1
    for m in "${model_list[@]}"; do
        printf "  %3d) %s\n" "$i" "$m"
        ((i++))
    done
    echo ""

    local choice
    while true; do
        read -rp "Select primary model [1-${#model_list[@]}]: " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && \
           [ "$choice" -ge 1 ] && \
           [ "$choice" -le "${#model_list[@]}" ]; then
            LITELLM_MODEL="${model_list[$((choice-1))]}"
            echo "Primary model: $LITELLM_MODEL"
            break
        fi
        echo "Invalid selection, please enter a number between 1 and ${#model_list[@]}."
    done

    # ── Small/fast model ───────────────────────────────────────────────────
    echo ""
    echo "Select small/fast model for background tasks (title generation, summaries):"
    echo ""
    echo "    0) Disable background model calls (default)"
    echo "    1) Same as primary ($LITELLM_MODEL)"
    local j=2
    for m in "${model_list[@]}"; do
        printf "  %3d) %s\n" "$j" "$m"
        ((j++))
    done
    echo ""

    local small_choice
    while true; do
        read -rp "Select small model [0-${#model_list[@]}] (Enter = disable): " small_choice
        small_choice="${small_choice:-0}"
        if [ "$small_choice" = "0" ]; then
            LITELLM_SMALL_MODEL=""
            echo "Background model calls: disabled"
            break
        elif [ "$small_choice" = "1" ]; then
            LITELLM_SMALL_MODEL="$LITELLM_MODEL"
            echo "Small model: $LITELLM_SMALL_MODEL (same as primary)"
            break
        elif [[ "$small_choice" =~ ^[0-9]+$ ]] && \
             [ "$small_choice" -ge 2 ] && \
             [ "$small_choice" -le $(( ${#model_list[@]} + 1 )) ]; then
            LITELLM_SMALL_MODEL="${model_list[$((small_choice-2))]}"
            echo "Small model: $LITELLM_SMALL_MODEL"
            break
        fi
        echo "Invalid selection, please enter a number between 0 and $(( ${#model_list[@]} + 1 ))."
    done
    echo ""
}

remove_stale_viewer_hooks() {
    # Earlier versions of this script injected Stop/UserPromptSubmit hooks
    # that POSTed to the viewer server. The viewer has never needed hooks
    # since (first a transcript tailer, now the Agent SDK driver), so this
    # strips any such hooks a previous run may have left behind in
    # settings.json.
    # Safe to call unconditionally and repeatedly — a no-op once cleaned,
    # and it never touches the file if nothing matches.
    local settings_file="$CONFIG_DIR/settings.json"
    [ -f "$settings_file" ] || return 0
    grep -q '/hook/\(stop\|user\)' "$settings_file" || return 0

    local cleaned
    cleaned=$(jq '
        def is_stale_cmd:
            (type == "object")
            and ((.command // "") | test("/hook/(stop|user)"));
        if has("hooks") then
            .hooks |= (
                with_entries(
                    .value = (
                        .value
                        | map(.hooks |= map(select(is_stale_cmd | not)))
                        | map(select((.hooks | length) > 0))
                    )
                )
            )
        else
            .
        end
    ' "$settings_file" 2>/dev/null) || return 0
    [ -n "$cleaned" ] || return 0

    echo "$cleaned" > "${settings_file}.tmp" && mv "${settings_file}.tmp" "$settings_file"
    echo "Removed stale viewer hooks from $settings_file."
}

remove_stale_viewer_hooks   # self-heal settings.json regardless of flags used this run

PROVIDER="direct"
PROVIDER_EXPLICIT=0
TUI_BACKEND=""      # "" (viewer, the default), "claude-code", or "opencode"
VIEWER_ENABLED=1    # the viewer is now the default interface; --claude/--opencode flip this off below
VIEWER_EXPLICIT=0   # did the user actually type --viewer, vs it just being the default
OPENCODE_PORT=7845
IMAGE_NAME="podprompt"   # which image to run; --image overrides
IMAGE_EXPLICIT=0         # did the user name one, vs it just being the default
DO_BUILD=0               # --build, deferred until every argument is known
HOST_NETWORK=0
PASSTHROUGH_ARGS=()
EXTRA_ENV_ARGS=()   # built from repeated --env NAME / --env NAME=VALUE flags
while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --list-models)
            list_models
            exit 0
            ;;
        --deploy-viewer)
            deploy_viewer
            exit 0
            ;;
        --build)
            DO_BUILD=1
            shift
            ;;
        --image)
            if [ -z "$2" ]; then
                echo "Error: --image needs an image name." >&2
                exit 1
            fi
            IMAGE_NAME="$2"
            IMAGE_EXPLICIT=1
            shift 2
            ;;
        --direct)
            PROVIDER="direct"
            PROVIDER_EXPLICIT=1
            shift
            ;;
        --direct-api)
            PROVIDER="direct-api"
            PROVIDER_EXPLICIT=1
            shift
            ;;
        --litellm)
            PROVIDER="litellm"
            PROVIDER_EXPLICIT=1
            shift
            ;;
        --claude|--claude-code)
            if [ -n "$TUI_BACKEND" ] && [ "$TUI_BACKEND" != "claude-code" ]; then
                echo "Error: --claude/--claude-code and --opencode are mutually exclusive — pick one interface." >&2
                exit 1
            fi
            TUI_BACKEND="claude-code"
            VIEWER_ENABLED=0
            shift
            ;;
        --opencode)
            if [ -n "$TUI_BACKEND" ] && [ "$TUI_BACKEND" != "opencode" ]; then
                echo "Error: --claude/--claude-code and --opencode are mutually exclusive — pick one interface." >&2
                exit 1
            fi
            TUI_BACKEND="opencode"
            VIEWER_ENABLED=0
            shift
            ;;
        --viewer)
            VIEWER_ENABLED=1
            VIEWER_EXPLICIT=1
            shift
            ;;
        --viewer-port)
            VIEWER_PORT="$2"
            shift 2
            ;;
        --viewer-driver-port)
            VIEWER_DRIVER_PORT="$2"
            shift 2
            ;;
        --opencode-port)
            OPENCODE_PORT="$2"
            shift 2
            ;;
        --host-network)
            HOST_NETWORK=1
            shift
            ;;
        --env)
            if [ -z "$2" ]; then
                echo "Error: --env needs a NAME or NAME=VALUE argument." >&2
                exit 1
            fi
            # Catches the likely mistake (the next flag got swallowed as
            # this one's argument, e.g. a forgotten value before
            # --host-network) rather than silently forwarding garbage to
            # docker run. Not a full env-var-name validator — docker's own
            # -e will reject whatever it doesn't like.
            case "$2" in
                [A-Za-z_]*) ;;
                *)
                    echo "Error: --env argument '$2' doesn't look like NAME or NAME=VALUE (must start with a letter or underscore)." >&2
                    exit 1
                    ;;
            esac
            EXTRA_ENV_ARGS+=(-e "$2")
            shift 2
            ;;
        *)
            PASSTHROUGH_ARGS+=("$1")
            shift
            ;;
    esac
done

# Run deferred actions now that every argument has been seen. --build cannot
# act inside the parse loop: `podprompt --build --image foo` would build and
# exit before --image was ever read, and silently ignoring it is exactly the
# kind of thing this refuses to do.
if [ "$DO_BUILD" = 1 ]; then
    if [ "$IMAGE_EXPLICIT" = 1 ]; then
        echo "Error: --build always builds this checkout's Dockerfile and tags it 'podprompt'." >&2
        echo "--image selects an image to RUN, so the two cannot be combined." >&2
        exit 1
    fi
    build_image
    exit 0
fi

# --viewer and --claude/--claude-code/--opencode are two different launch
# modes entirely — the browser viewer, with both backends live per session,
# vs. a direct single-backend terminal session — and combining them doesn't
# mean anything sensible (there's only one foreground process in the
# container to hand to either interface). --claude/--opencode already flip
# VIEWER_ENABLED off above; this only needs to catch an *explicit* --viewer
# alongside one of them, which would otherwise look like --viewer was just
# silently ignored rather than actively rejected.
if [ "$VIEWER_EXPLICIT" = 1 ] && [ -n "$TUI_BACKEND" ]; then
    echo "Error: --viewer is mutually exclusive with --claude/--claude-code/--opencode — the viewer already supports both backends live, per session; pick one interface." >&2
    exit 1
fi

# Passthrough args only ever mean anything to the binary --claude/--opencode
# execs directly — --viewer (the default) never execs either binary at all,
# so silently accepting them would look like they did something. Surfaced as
# a warning rather than a hard error, since this used to be the unconditional
# default behavior (bare `podprompt --dangerously-skip-permissions` used
# to work) and a warning is enough to catch the now-missing --claude/--opencode
# without breaking anything further.
if [ "$VIEWER_ENABLED" = 1 ] && [ "${#PASSTHROUGH_ARGS[@]}" -gt 0 ]; then
    echo "Warning: ignoring passthrough argument(s) (${PASSTHROUGH_ARGS[*]}) — they only apply to --claude/--opencode's direct terminal session; --viewer never execs either binary directly." >&2
fi

# --direct-api only ever configures Claude Code's own credentials
# (ANTHROPIC_AUTH_TOKEN/ANTHROPIC_MODEL below) — meaningless, not just
# unused, for a plain `--opencode` TUI launch, which execs `opencode`
# directly and never reads those env vars at all. Only checked for that
# direct-TUI case: under --viewer, a claude-code-backed session can still
# exist alongside opencode ones and would legitimately use this config,
# since both backends are always registered regardless of which one any
# given session picks.
#
# --litellm is deliberately NOT included here: LiteLLM is a perfectly good
# (arguably easier, since it's plain OpenAI-compatible) backend for OpenCode
# too — see the --litellm doc above and PERSISTENT STATE below for how to
# point OpenCode's own config at it. It just doesn't go through Claude
# Code's ANTHROPIC_* env vars to get there, so the interactive Claude-Code
# model picker is skipped for a plain opencode launch (see below) and
# LITELLM_URL/LITELLM_API_KEY are passed through as plain env vars instead,
# for opencode.jsonc's own {env:...} substitution to use.
if [ "$TUI_BACKEND" = "opencode" ] && [ "$PROVIDER_EXPLICIT" = 1 ] \
   && [ "$PROVIDER" = "direct-api" ]; then
    echo "Error: --direct-api configures Claude Code's own credentials and has no effect on --opencode." >&2
    echo "OpenCode manages its own provider auth — run 'podprompt --opencode' and use its" >&2
    echo "TUI's own first-run login (or 'opencode auth login' inside the container); it persists to this host's" >&2
    echo "own ~/.config/opencode/ and ~/.local/share/opencode/, independent of ~/.claude/." >&2
    exit 1
fi

# ── Workspace preflight ───────────────────────────────────────────────────────
# The cwd becomes /workspace, writable by agents inside the container. That is
# the whole point of invoking this from your project directory, but it means a
# stray run from somewhere enormous mounts somewhere enormous. Warn, confirm,
# and get out of the way — the answer to "are you sure" is allowed to be yes.
#
# One rule, chosen because it is predictable rather than clever: complain when
# the cwd is $HOME or an ancestor of it. That covers $HOME, /, /home and
# /Users, and nothing a real project directory would ever match.
WORKSPACE_PATH="$(pwd)"
require_image

workspace_is_too_broad() {
    [ "$WORKSPACE_PATH" = "/" ] && return 0
    case "$HOME/" in
        "$WORKSPACE_PATH"/*) return 0 ;;
    esac
    return 1
}

if workspace_is_too_broad && [ "${PODPROMPT_YES:-0}" != 1 ]; then
    echo "Warning: this would mount $WORKSPACE_PATH at /workspace." >&2
    if [ "$WORKSPACE_PATH" = "$HOME" ]; then
        echo "That is your entire home directory, writable by agents in the container." >&2
    else
        echo "That contains your home directory, writable by agents in the container." >&2
    fi
    echo "Usually you want to cd into a specific project first." >&2
    if [ -t 0 ]; then
        printf 'Continue anyway? [y/N] ' >&2
        read -r reply
        case "$reply" in
            [yY]|[yY][eE][sS]) ;;
            *) echo "Aborted." >&2; exit 1 ;;
        esac
    else
        # Nothing to read an answer from, and refusing outright would break
        # anyone scripting this deliberately. Say so loudly and continue;
        # PODPROMPT_YES=1 silences this.
        echo "Not a terminal, so continuing without confirmation. Set PODPROMPT_YES=1 to silence this." >&2
    fi
fi

# Always say what is being mounted. The cwd is an implicit argument to this
# command, so it should never be a guess.
echo "Workspace: $WORKSPACE_PATH → /workspace"

# Resolve provider-specific settings
if [ "$PROVIDER" = "litellm" ]; then
    if [ -z "$LITELLM_API_KEY" ]; then
        echo "Error: LITELLM_API_KEY is not set."
        exit 1
    fi

    echo "Checking LiteLLM server..."
    status=$(curl -s --max-time 5 -o /dev/null -w "%{http_code}" "$LITELLM_URL/health")
    if [ "$status" = "000" ]; then
        echo "Warning: LiteLLM server at $LITELLM_URL is not reachable."
        echo "Continue anyway? [y/N]"
        read -r answer
        [[ "$answer" =~ ^[Yy]$ ]] || exit 1
    else
        echo "LiteLLM server OK (HTTP $status)."
    fi

    if [ "$TUI_BACKEND" = "opencode" ]; then
        # Plain `--opencode --litellm`: opencode picks its own
        # model via its own config (or its TUI's own /models, /connect),
        # not Claude Code's ANTHROPIC_MODEL env var — so skip Claude Code's
        # interactive model picker here, since a launch that never execs
        # `claude` would never read its result anyway. (`--list-models` is
        # still there if you just want to see what LiteLLM exposes before
        # writing opencode.jsonc's model list.) LITELLM_URL/LITELLM_API_KEY
        # still get passed through as plain env vars below either way.
        EFFECTIVE_BASE_URL=""
        EFFECTIVE_TOKEN=""
        EFFECTIVE_MODEL=""
        EFFECTIVE_SMALL_MODEL=""
    else
        pick_model   # always run the interactive picker when Claude Code will read the result

        EFFECTIVE_BASE_URL="$LITELLM_URL"
        EFFECTIVE_TOKEN="$LITELLM_API_KEY"
        EFFECTIVE_MODEL="$LITELLM_MODEL"
        EFFECTIVE_SMALL_MODEL="$LITELLM_SMALL_MODEL"
    fi

elif [ "$PROVIDER" = "direct-api" ]; then
    if [ -z "$ANTHROPIC_API_KEY" ]; then
        echo "Error: ANTHROPIC_API_KEY is not set (required for --direct-api)."
        exit 1
    fi
    EFFECTIVE_BASE_URL=""
    EFFECTIVE_TOKEN="$ANTHROPIC_API_KEY"
    EFFECTIVE_MODEL=""
    EFFECTIVE_SMALL_MODEL=""
    echo "Using Anthropic API (key-based billing)."

else
    # Default: OAuth via claude.ai subscription.
    # No token injected — Claude Code reads OAuth credentials from the
    # mounted ~/.claude directory. On first run it will prompt for login.
    EFFECTIVE_BASE_URL=""
    EFFECTIVE_TOKEN=""
    EFFECTIVE_MODEL=""
    EFFECTIVE_SMALL_MODEL=""
    echo "Using claude.ai subscription (OAuth)."
fi

docker rm -f podprompt 2>/dev/null

# Saves OAuth credentials, settings, session history, and per-project trust.
# CLAUDE_CONFIG_DIR makes Claude Code write .claude.json into this same
# directory instead of splitting it out to $HOME/.claude.json.
CONNECT_CONFIG="${CONFIG_DIR}:/home/agent/.claude:z"

# ── Viewer setup ──────────────────────────────────────────────────────────────
VIEWER_PORT_FLAGS=()

if [ "$VIEWER_ENABLED" = 1 ]; then
    # node_modules is deliberately not checked here: it's baked into the
    # Docker image at build time now (see Dockerfile), not deployed to the
    # host by --deploy-viewer, so it's never something that can be missing
    # from $PODPROMPT_DATA_DIR/viewer. backends/ is a directory, so the
    # existence check below uses -e (exists) rather than -f (regular file).
    for f in server.py viewer.html start-viewer.sh driver.mjs backends; do
        if [ ! -e "$PODPROMPT_DATA_DIR/viewer/$f" ]; then
            echo "Error: $PODPROMPT_DATA_DIR/viewer/$f not found."
            echo "Run 'podprompt --deploy-viewer' to install/update the viewer there."
            exit 1
        fi
    done

    VIEWER_PORT_FLAGS=(-p "127.0.0.1:${VIEWER_PORT}:${VIEWER_PORT}" -p "127.0.0.1:${VIEWER_DRIVER_PORT}:${VIEWER_DRIVER_PORT}")
    free_host_port "$VIEWER_PORT" || exit 1
    free_host_port "$VIEWER_DRIVER_PORT" || exit 1

    # server.py is a plain broadcast relay; driver.mjs (Agent SDK-based) is
    # what actually drives either backend and is what the browser will talk
    # to once it has an input box; start-viewer.sh also launches a headless
    # `opencode serve` alongside them, loopback-only, so the opencode backend
    # is always usable regardless of which backend any given session picks.
    # All three start inside the container.
    echo "Viewer: opening http://localhost:$VIEWER_PORT in your browser once it's up..."
    wait_and_open_viewer "$VIEWER_PORT" &
    VIEWER_OPEN_PID=$!
fi

# ── Host networking ────────────────────────────────────────────────────────────
# --host-network puts the container on the host's network stack (--network host)
# so services the host listens on loopback-only (e.g. llama-server bound to
# 127.0.0.1:8080) are reachable at the same 127.0.0.1 address from inside the
# container, with no -p publishes and no LAN exposure. Native and reliable on
# Linux; on macOS it needs Docker Desktop 4.34+ with the "Enable host
# networking" setting in Settings > Resources > Network.
# What the in-container viewer services bind to. 0.0.0.0 is REQUIRED under the
# default bridge network: a service bound to 127.0.0.1 inside the container is
# not reachable through a -p publish at all. It is safe there precisely because
# the publish is itself scoped (-p 127.0.0.1:PORT:PORT) and the container has
# its own network namespace.
#
# Under --host-network neither of those holds: there is no namespace and no
# publish, so a 0.0.0.0 bind lands on EVERY host interface and puts the driver's
# whole control plane on the LAN — the opposite of what this flag documents.
# So host networking forces the bind back to loopback, which is also all that
# mode ever needed: the browser reaches the services at 127.0.0.1 directly.
BIND_ADDR=0.0.0.0
NETWORK_FLAG=()
if [ "$HOST_NETWORK" = 1 ]; then
    NETWORK_FLAG=(--network host)
    BIND_ADDR=127.0.0.1
    # -p publishes are discarded under host networking (Docker warns about it);
    # drop them up front so no stale 127.0.0.1:PORT publishes linger in the
    # command. Server-side listeners inside the container now bind into the
    # host's own address space instead, on the same ports.
    VIEWER_PORT_FLAGS=()
    if [ "$(uname -s)" = "Darwin" ]; then
        echo "Warning: --host-network on macOS requires Docker Desktop 4.34+ with" >&2
        echo "Settings > Resources > Network > 'Enable host networking' turned on." >&2
        echo "If host services aren't reachable at 127.0.0.1 from inside the container" >&2
        echo "(e.g. llama-server at http://127.0.0.1:8080/v1), enable that toggle," >&2
        echo "restart Docker Desktop, and try again." >&2
    fi
fi

# ── Interface (plain terminal) ────────────────────────────────────────────────
# The base image's Node entrypoint execs any bare command that's actually on
# PATH as-is (falls back to prefixing `node` only for things it can't find,
# or scripts without +x) — `claude` and `opencode` both work as bare
# commands unmodified. Only --viewer needs --entrypoint, since it launches a
# custom script instead of a single binary.

ENTRYPOINT_FLAG=()   # empty = use image default (Node, which runs claude/opencode fine)

if [ "$VIEWER_ENABLED" = 1 ]; then
    ENTRYPOINT_FLAG=(--entrypoint /home/agent/.local/share/podprompt/viewer/start-viewer.sh)
    RUN_CMD=("${PASSTHROUGH_ARGS[@]}")
elif [ "$TUI_BACKEND" = "opencode" ]; then
    RUN_CMD=(opencode "${PASSTHROUGH_ARGS[@]}")
else
    RUN_CMD=(claude "${PASSTHROUGH_ARGS[@]}")
fi

# OpenCode's own credentials/config/sessions (see `opencode debug paths`)
# persist by bind-mounting this host's own standard XDG directories
# straight onto opencode's identical default paths inside the container —
# no XDG_*_HOME override needed, since that's already where a plain
# `opencode` looks. Populated whenever opencode might actually run in this
# container: --viewer (the default) always starts a headless `opencode
# serve` regardless of which backend any given session picks, and a plain
# --opencode launch runs its TUI directly. A container that's neither
# (--claude) doesn't touch opencode at all, so skip the mounts rather than
# exposing host directories it'll never use.
OPENCODE_MOUNT_FLAGS=()
if [ "$VIEWER_ENABLED" = 1 ] || [ "$TUI_BACKEND" = "opencode" ]; then
    OPENCODE_MOUNT_FLAGS+=(
        -v "${OPENCODE_CONFIG_DIR}:/home/agent/.config/opencode:z"
        -v "${OPENCODE_DATA_DIR}:/home/agent/.local/share/opencode:z"
        -v "${OPENCODE_STATE_DIR}:/home/agent/.local/state/opencode:z"
        -v "${OPENCODE_CACHE_DIR}:/home/agent/.cache/opencode:z"
    )
fi

# PodPrompt's own state (deployed viewer app + its bookkeeping files) — only
# relevant when --viewer is actually running; a plain terminal session (either
# backend) never touches either of these, so skip the mounts otherwise.
PODPROMPT_MOUNT_FLAGS=()
if [ "$VIEWER_ENABLED" = 1 ]; then
    PODPROMPT_MOUNT_FLAGS+=(
        -v "${PODPROMPT_DATA_DIR}/viewer:/home/agent/.local/share/podprompt/viewer:z"
        -v "${PODPROMPT_STATE_DIR}:/home/agent/.local/state/podprompt:z"
    )
fi

# Build the litellm-specific env flags separately for clarity.
# DISABLE_NON_ESSENTIAL_MODEL_CALLS suppresses background model calls
# (title generation, summaries) when no small/fast model is configured.
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS prevents beta headers that some
# LiteLLM versions reject with HTTP 400.
# DISABLE_TELEMETRY stops telemetry pings to Anthropic's servers.
# These ANTHROPIC_* vars are Claude-Code-specific and only make sense when
# EFFECTIVE_BASE_URL/EFFECTIVE_TOKEN are actually set — which the block
# above deliberately leaves empty for a plain `--opencode --litellm`
# launch, so none of this is emitted into a container that never execs
# `claude` at all.
LITELLM_ENV_FLAGS=()
if [ "$PROVIDER" = "litellm" ] && [ -n "$EFFECTIVE_TOKEN" ]; then
    LITELLM_ENV_FLAGS+=(
        -e ANTHROPIC_BASE_URL="$EFFECTIVE_BASE_URL"
        -e ANTHROPIC_AUTH_TOKEN="$EFFECTIVE_TOKEN"
        -e DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
        -e CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
        -e DISABLE_TELEMETRY=1
    )
    if [ -n "$EFFECTIVE_MODEL" ]; then
        LITELLM_ENV_FLAGS+=(-e ANTHROPIC_MODEL="$EFFECTIVE_MODEL")
    fi
    if [ -n "$EFFECTIVE_SMALL_MODEL" ]; then
        LITELLM_ENV_FLAGS+=(
            -e ANTHROPIC_DEFAULT_HAIKU_MODEL="$EFFECTIVE_SMALL_MODEL"
            -e ANTHROPIC_SMALL_FAST_MODEL="$EFFECTIVE_SMALL_MODEL"
        )
    fi
fi

# Plain (non-ANTHROPIC_*) LITELLM_URL/LITELLM_API_KEY, passed through
# whenever --litellm is used regardless of backend, so a hand-written
# opencode.jsonc custom provider can reference them via OpenCode's own
# {env:LITELLM_URL}/{env:LITELLM_API_KEY} config substitution instead of
# hardcoding the key into a file. (That substitution has had reliability
# issues for some custom-provider fields in some OpenCode versions — if it
# doesn't seem to take, store the key via the TUI's /connect flow instead
# and drop apiKey from opencode.jsonc entirely; see --opencode doc above.)
OPENCODE_LITELLM_ENV_FLAGS=()
if [ "$PROVIDER" = "litellm" ]; then
    OPENCODE_LITELLM_ENV_FLAGS+=(
        -e LITELLM_URL="$LITELLM_URL"
        -e LITELLM_API_KEY="$LITELLM_API_KEY"
    )
fi

# No --platform flag: this deliberately lets both `docker build` and this
# `docker run` default to the host's own native architecture, on Linux
# x86_64 and macOS (Intel or Apple Silicon) alike. Every dependency this
# image actually installs (Claude Code CLI, OpenCode, the viewer's Claude
# Agent SDK — see Dockerfile/viewer/package-lock.json) ships native arm64
# builds already, so there's nothing here that needs amd64 specifically. An
# explicit linux/amd64 pin used to be forced here; on Apple Silicon that
# meant a plain, undocumented `docker build -t podprompt .` (which builds
# natively for arm64) no longer matched what `docker run` asked for, which
# is unreliable across Docker Desktop versions — either a hard "platform
# does not match" error, or silent forced emulation of an image that was
# never actually built for amd64. Pass --platform explicitly on the command
# line yourself (both to `docker build` and here) if you ever need to force
# a specific architecture regardless of host.
docker run -it --rm \
  --name podprompt \
  --user "$(id -u):$(id -g)" \
  --security-opt label=disable \
  --init \
  "${NETWORK_FLAG[@]}" \
  "${ENTRYPOINT_FLAG[@]}" \
  -e HOME=/home/agent \
  -e CLAUDE_CONFIG_DIR=/home/agent/.claude \
  -e VIEWER_PORT="$VIEWER_PORT" \
  -e VIEWER_DRIVER_PORT="$VIEWER_DRIVER_PORT" \
  -e OPENCODE_PORT="$OPENCODE_PORT" \
  -e PODPROMPT_BIND_ADDR="$BIND_ADDR" \
  -e HOST_WORKSPACE_PATH="$WORKSPACE_PATH" \
  ${EFFECTIVE_TOKEN:+-e ANTHROPIC_AUTH_TOKEN="$EFFECTIVE_TOKEN"} \
  ${EFFECTIVE_MODEL:+-e ANTHROPIC_MODEL="$EFFECTIVE_MODEL"} \
  "${LITELLM_ENV_FLAGS[@]}" \
  "${OPENCODE_LITELLM_ENV_FLAGS[@]}" \
  "${EXTRA_ENV_ARGS[@]}" \
  "${VIEWER_PORT_FLAGS[@]}" \
  -v "$WORKSPACE_PATH:/workspace:z" \
  --workdir /workspace \
  -v "${CONNECT_CONFIG}" \
  "${OPENCODE_MOUNT_FLAGS[@]}" \
  "${PODPROMPT_MOUNT_FLAGS[@]}" \
  "$IMAGE_NAME" \
  "${RUN_CMD[@]}"
