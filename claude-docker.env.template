# ~/.claude-docker.env
# Keep this file out of version control (chmod 600).
# Source it in your shell session: source ~/.claude-docker.env
# Or add the source line to your .bashrc / .zshrc.

# --- Direct Anthropic API (--direct-api mode only) ---
# Only needed if you use --direct-api (per-token API billing via Anthropic Console).
# The default --direct mode uses OAuth via your claude.ai subscription instead,
# and does not require this key.
ANTHROPIC_API_KEY="sk-ant-..."

# --- LiteLLM instance (--litellm mode) ---
# Model selection happens interactively at launch via a numbered menu.
LITELLM_URL="https://your-litellm-instance"
LITELLM_API_KEY="sk-..."
